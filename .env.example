# Relay server environment.
# Copy to server/.env (or wire into your secret manager) before starting the server.

# --- Slack (required) ----------------------------------------------------
# Bot user OAuth token (xoxb-...) from your Slack app's "OAuth & Permissions" tab.
SLACK_BOT_TOKEN=xoxb-replace-me

# App-level token (xapp-...) for Socket Mode. Scopes: connections:write.
SLACK_APP_TOKEN=xapp-replace-me

# --- Public URLs (required) ----------------------------------------------
# Public HTTPS base URL of this server (used in DM install instructions).
PUBLIC_SERVER_URL=https://your-server.example.com

# Public WSS endpoint clients connect to. Typically PUBLIC_SERVER_URL/ws over wss://.
PUBLIC_WS_URL=wss://your-server.example.com/ws

# --- Server identity (required) ------------------------------------------
# Ed25519 keypair generated by `tsx server/scripts/bootstrap-keypair.ts`.
SERVER_PRIVATE_KEY_PATH=./data/server-ed25519.key
SERVER_PUBLIC_KEY_PATH=./data/server-ed25519.pub

# --- Auto-update gate (required) -----------------------------------------
# npm username whose @<scope>/claude-slackbot publishes are trusted by clients.
ALLOWED_NPM_PUBLISHER=your-npm-username

# --- Storage (optional) --------------------------------------------------
# SQLite database file. Defaults to ./data/claude-slackbot.sqlite.
# Mount this path on a persistent volume in production.
DATABASE_PATH=./data/claude-slackbot.sqlite

# --- Process (optional) --------------------------------------------------
# Listen port. Defaults to 8443.
PORT=8443

# Log verbosity. trace|debug|info|warn|error|fatal. Defaults to info.
LOG_LEVEL=info

# Optional path to a JSON-lines log file mirroring stdout. Empty = disabled.
LOG_FILE=
