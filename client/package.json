{
  "name": "@nikitiuk0/claude-slackbot",
  "version": "0.2.0-dev.0",
  "description": "Claude Code daemon paired to a shared Slack bot via claude-slackbot relay",
  "type": "module",
  "bin": { "claude-slackbot": "dist/index.js" },
  "main": "dist/index.js",
  "files": ["dist", "src/core/prompt/system-prompt.txt"],
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@slack/bolt": "^3.21.0",
    "dotenv": "^17.4.2",
    "jose": "^5.9.0",
    "ndjson": "^2.0.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/ndjson": "^2.0.4",
    "@types/node": "^20.12.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
